{
  "expo": {
    "name": "Katha AAC",
    "slug": "katha-aac",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.katha.aac",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-dev-client",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSansSinhala_400Regular.ttf",
            "./assets/fonts/NotoSansSinhala_500Medium.ttf",
            "./assets/fonts/NotoSansSinhala_600SemiBold.ttf",
            "./assets/fonts/NotoSansSinhala_700Bold.ttf",
            "./assets/fonts/NotoSans_400Regular.ttf",
            "./assets/fonts/NotoSans_600SemiBold.ttf",
            "./assets/fonts/NotoSans_700Bold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-sharing",
      "expo-localization",
      "expo-asset"
    ]
  }
}
