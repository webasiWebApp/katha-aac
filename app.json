{
  "expo": {
    "name": "Katha AAC",
    "slug": "katha-aac",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/app/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.katha.aac",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/app/adaptive-foreground.png",
        "backgroundImage": "./assets/app/adaptive-background.png",
        "monochromeImage": "./assets/app/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.katha.aac",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-dev-client",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSansSinhala_400Regular.ttf",
            "./assets/fonts/NotoSansSinhala_500Medium.ttf",
            "./assets/fonts/NotoSansSinhala_600SemiBold.ttf",
            "./assets/fonts/NotoSansSinhala_700Bold.ttf",
            "./assets/fonts/NotoSans_400Regular.ttf",
            "./assets/fonts/NotoSans_600SemiBold.ttf",
            "./assets/fonts/NotoSans_700Bold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-asset",
      "./plugins/withReleaseSigning"
    ],
    "splash": {
      "image": "./assets/app/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    }
  }
}
